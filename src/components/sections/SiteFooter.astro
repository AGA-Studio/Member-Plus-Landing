---
import Logo from "@/components/ui/Logo.astro";
import { siteConfig } from "@/config/site";
import { languageNames, localePath, type Locale, type Messages } from "@/i18n";
import { legalPaths } from "@/lib/routes";

type Props = { locale: Locale; messages: Messages; languageHref?: string };

const { locale, messages, languageHref } = Astro.props;
const otherLocale: Locale = locale === "es" ? "en" : "es";
const footer = messages.footer;
const year = new Date().getFullYear();
const mail = (address: string, subject: string) => `mailto:${address}?subject=${encodeURIComponent(subject)}`;
const accessHref = mail(siteConfig.accessEmail, messages.common.requestAccessSubject);

const legalLinks = [
  { href: legalPaths.privacy[locale], label: footer.privacy },
  { href: legalPaths.terms[locale], label: footer.terms },
];
const accountLinks = [
  { href: siteConfig.loginUrl, label: messages.common.login },
  { href: accessHref, label: messages.common.requestAccess },
];

const linkClass =
  "inline-flex min-h-11 items-center text-base text-ink-200 transition-colors duration-150 ease-out hover:text-white";
const buttonClass =
  "inline-flex h-11 items-center justify-center rounded-md border border-ink-600 px-5 text-sm font-semibold text-white transition-[transform,background-color] duration-150 ease-out hover:bg-ink-800 active:scale-97";
---

<footer aria-label={footer.label} class="bg-ink-950 px-4 pt-16 pb-8 text-ink-200 sm:px-6 lg:px-8">
  <div class="mx-auto grid max-w-page gap-12 lg:grid-cols-3">
    <div class="flex flex-col items-start gap-5">
      <Logo tone="dark" alt="Member+" class="h-8 w-auto" />
      <p class="max-w-xs text-base text-ink-300">{footer.tagline}</p>
      <div class="flex flex-wrap gap-3">
        <a href={mail(siteConfig.contactEmail, footer.contactSubject)} class={buttonClass}>{footer.contact}</a>
        <a href={mail(siteConfig.supportEmail, footer.supportSubject)} class={buttonClass}>{footer.support}</a>
      </div>
    </div>

    <nav aria-labelledby="footer-legal" class="flex flex-col gap-1">
      <h2 id="footer-legal" class="mb-2 font-display text-base font-semibold text-white">{footer.legal}</h2>
      {legalLinks.map((link) => <a href={link.href} class={linkClass}>{link.label}</a>)}
    </nav>

    <nav aria-labelledby="footer-account" class="flex flex-col gap-1">
      <h2 id="footer-account" class="mb-2 font-display text-base font-semibold text-white">{footer.account}</h2>
      {accountLinks.map((link) => <a href={link.href} class={linkClass}>{link.label}</a>)}
      <a
        href={languageHref ?? localePath(otherLocale)}
        lang={otherLocale}
        hreflang={otherLocale}
        aria-label={`${messages.common.language}: ${languageNames[otherLocale]}`}
        class="mt-3 inline-flex h-11 w-fit items-center rounded-md border border-ink-600 px-4 text-sm font-medium text-white transition-[transform,background-color] duration-150 ease-out hover:bg-ink-800 active:scale-97"
      >
        {languageNames[otherLocale]}
      </a>
    </nav>
  </div>

  <div class="mx-auto mt-14 flex max-w-page flex-col gap-2 border-t border-ink-800 pt-6 text-sm text-ink-300 sm:flex-row sm:items-center sm:justify-between">
    <p>{footer.madeBy}</p>
    <p>{footer.copyright.replace("{year}", String(year))}</p>
  </div>
</footer>
